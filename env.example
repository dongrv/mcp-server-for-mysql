# MySQL MCP Server 环境变量配置

# MySQL 连接配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=test

# 连接池配置
MYSQL_MAX_CONNS=10
MYSQL_IDLE_CONNS=5
MYSQL_CONN_LIFETIME_MINUTES=30

# 日志配置（可选）
# LOG_LEVEL=info
# LOG_FORMAT=json

# 服务器配置（可选）
# SERVER_HOST=localhost
# SERVER_PORT=8080
# SERVER_TIMEOUT=30s

# 安全配置（可选）
# SSL_MODE=disable
# SSL_CERT=
# SSL_KEY=
# SSL_CA=

# 性能配置（可选）
# QUERY_TIMEOUT=30s
# MAX_QUERY_SIZE=1048576  # 1MB
# ENABLE_QUERY_CACHE=true
# QUERY_CACHE_SIZE=1000

# 监控配置（可选）
# ENABLE_METRICS=true
# METRICS_PORT=9090
# ENABLE_TRACING=false
# TRACING_ENDPOINT=localhost:4317

# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置
# 3. 确保 MySQL 服务正在运行
# 4. 数据库用户需要有足够的权限
